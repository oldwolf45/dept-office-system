# ============================================================
# 科室协同办公系统 — 环境变量示例
# 用法：cp .env.example .env（Windows: Copy-Item .env.example .env）
# Docker 路径由 docker-compose 通过 env_file 自动注入容器。
# ============================================================

# 发行模式开关：1=发行模式（首次启动 0 账号，网页引导建管理员，不预置任何账号）
# 请勿改成其他值。
DISTRIBUTION_MODE=1

# JWT 登录密钥：生产环境务必改成随机长串（>=32 位）
JWT_SECRET=

# MiniMax 大模型 API Key：选填。填后才能用"AI 生成月度总结 / 汇报 PPT"；不填其余功能全部正常
MINIMAX_API_KEY=